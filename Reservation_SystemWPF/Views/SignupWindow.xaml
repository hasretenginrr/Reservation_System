<Window x:Class="Reservation_SystemWPF.Views.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign Up" Height="500" Width="450">
    <Border Background="#f4f4f4" CornerRadius="8" Padding="20" Height="460" Width="410">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Sign Up" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>

                <TextBlock Text="User Name" Margin="0,5,0,0"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Email" Margin="0,5,0,0"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Phone" Margin="0,5,0,0"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="SignUp" Background="#28a745" Foreground="White" Margin="0,15,0,0" Height="40" Command="{Binding SignUpCommand}"/>
                <Button Content="Back to Login" Background="#6c757d" Foreground="White" Margin="0,10,0,0" Height="40" Click="BackToLogin_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
