<Window x:Class="Reservation_SystemWPF.Views.ReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="New Reservation"
        Height="500" Width="400"
        Background="AliceBlue"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>
        <Border Width="320" Height="420"
                Background="White"
                CornerRadius="12"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15"
                                  Direction="-90" 
                                  RenderingBias="Quality" 
                                  ShadowDepth="2" 
                                  Color="Gray" />
            </Border.Effect>

            <!-- StackPanel'de Spacing yok, onun yerine Margin kullandım -->
            <StackPanel>
                <!-- Başlık -->
                <TextBlock Text="Create Reservation" 
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Category -->
                <TextBlock Text="Category" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                  DisplayMemberPath="CategoryName"
                  SelectedValuePath="CategoryId"
                  Width="200"
                  Margin="10"/>


                <!-- Reservation Date -->
                <TextBlock Text="Reservation Date" FontWeight="SemiBold"/>
                <DatePicker Width="260"
                            Margin="0,5,0,10"
                            SelectedDate="{Binding ReservationDate}"
                            DisplayDateStart="{x:Static sys:DateTime.Now}">
                    <DatePicker.Resources>
                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>

                <!-- People Count -->
                <TextBlock Text="People Count" FontWeight="SemiBold"/>
                <TextBox Width="260" 
                         Margin="0,5,0,20"
                         Padding="6"
                         BorderThickness="0,0,0,1"
                         BorderBrush="LightGray"
                         Text="{Binding PeopleCount, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Submit Button -->
                <Button Content="Reserve"
                        Width="260" Height="36"
                        Background="#0078D7" Foreground="White"
                        FontWeight="Bold"
                        Command="{Binding CreateReservationCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="AliceBlue"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
