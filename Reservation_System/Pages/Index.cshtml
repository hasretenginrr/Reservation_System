    <script>
            $(document).ready(function () {
            $("#contactForm").on("submit", function(e) {

                e.preventDefault(); // Formun normal submit işlemini engelle

                $(".loading").show();
                $(".error-message, .sent-message").hide();

                var messagesDto = {
                    Email: $("#email").val(),
                    Message: $("#message").val(),
                    Name: $("#name").val(),
                    Subject: $("#subject").val()
                };

                console.log(JSON.stringify(messagesDto));

                $.ajax({
                    url: "https://localhost:7067/api/Messages",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(messagesDto),
                    success: function(data) {
                        if (data.hasError) {
                            $("#errorMsg").show().text(data.message || "Hata oluştu.");
                            $("#successMsg").hide();
                        } else {
                            $("#successMsg").show().text(data.message || "Mesaj başarı ile alındı!");
                            $("#errorMsg").hide();
                            $("#contactForm")[0].reset();
                            window.location.href = "/"; // <-- window.location yanlış kullanılmış
                        }
                    },
                    error: function(xhr) {
                        $(".loading").hide();
                        $(".error-message").text("Hata oluştu: " + xhr.responseText).show();
                    }
                });
            });
        });

    </script>

</body>

</html>
