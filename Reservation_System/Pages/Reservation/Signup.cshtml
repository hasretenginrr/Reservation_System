@page
@model Reservation_System.Pages.Reservation.SignupModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign Up</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(to right, #DE563E, #C72E14);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .signup-card {
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            max-width: 900px;
            width: 100%;
        }

        .signup-left {
            background: url("\\images\\aa.jpg") no-repeat center center;
            background-size: cover;
            min-height: 100%;
        }

        .signup-right {
            padding: 50px;
        }

        .form-control {
            border-radius: 30px;
            padding-left: 40px;
        }

        .form-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
        }

        .btn-custom {
            border-radius: 30px;
            padding: 10px;
        }

        .social-icons a {
            margin: 0 10px;
            font-size: 24px;
            color: #555;
        }

            .social-icons a:hover {
                color: #E86454;
            }

        #errorMsg {
            display: none;
        }
    </style>
</head>
<body>
    <div class="signup-card row g-0">
        <div class="col-md-6 d-none d-md-block signup-left"></div>

        <div class="col-md-6 signup-right">
            <h3 class="mb-4 text-center">Create Account</h3>
            <p class="text-muted text-center">Sign up to get started</p>

            <div id="errorMsg" class="bg-danger text-white p-2 rounded mb-3 text-center"></div>
            <div id="successMsg" class="bg-success text-white p-2 rounded mb-3 text-center" style="display:none;"></div>

            <form id="signupForm">
                <div class="mb-3 position-relative">
                    <i class="fa fa-user form-icon"></i>
                    <input type="text" id="username" class="form-control" placeholder="Username" required />
                </div>

                <div class="mb-3 position-relative">
                    <i class="fa fa-envelope form-icon"></i>
                    <input type="email" id="mail" class="form-control" placeholder="Email" required />
                </div>

                <div class="mb-3 position-relative">
                    <i class="fa fa-phone form-icon"></i>
                    <input type="text" id="phone" class="form-control" placeholder="Phone" required />
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-custom">SIGN UP</button>
                    <a href="/Reservation/Login" class="btn btn-outline-primary btn-custom text-center">LOGIN</a>
                </div>
            </form>

            <div class="text-center mt-4">
                <p class="text-muted">Or sign up with</p>
                <div class="social-icons">
                    <a href="#"><i class="fab fa-facebook"></i></a>
                    <a href="#"><i class="fab fa-google"></i></a>
                    <a href="#"><i class="fab fa-linkedin"></i></a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#signupForm').on("submit", function (e) {
                e.preventDefault();
                var UserDto={
                    userName: $("#username").val(),
                    mail: $("#mail").val(),
                    phone: $("#phone").val()
                };

               $.ajax({
                    url: "https://localhost:7067/api/User",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(UserDto),
                    success: function (data) {
                        if (data.hasError) {
                            $("#errorMsg").show().text(data.message || "Hata oluştu.");
                            $("#successMsg").hide();
                        } else {
                            $("#successMsg").show().text(data.message || "Rezervasyon başarılı!");
                            $("#errorMsg").hide();
                            $("#reservationForm")[0].reset();
                           
                            
                        }
                    },
                    error: function () {
                        $("#errorMsg").show().text("Sunucuya bağlanılamadı.");
                        $("#successMsg").hide();
                    }
                });
            });
        });
    </script>
