@page
@model Reservation_System.Pages.Reservation.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(to right, #DE563E, #C72E14);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            max-width: 900px;
            width: 100%;
        }

        .login-left {
            background: url("\\images\\aa.jpg") no-repeat center center;
            background-size: cover;
            min-height: 100%;
        }

        .login-right {
            padding: 50px;
        }

        .form-control {
            border-radius: 30px;
            padding-left: 40px;
        }

        .form-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
        }

        .btn-custom {
            border-radius: 30px;
            padding: 10px;
        }

        .social-icons a {
            margin: 0 10px;
            font-size: 24px;
            color: #555;
        }

            .social-icons a:hover {
                color: #E86454;
            }
    </style>
</head>
<body>
    <div class="login-card row g-0">
        <!-- Sol taraf (görsel) -->
        <div class="col-md-6 d-none d-md-block login-left"></div>

        <!-- Sağ taraf (form) -->
        <div class="col-md-6 login-right">
            <h3 class="mb-4 text-center">Welcome!</h3>
            <p class="text-muted text-center">Sign in to your account</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="bg-danger text-white p-2 rounded mb-3 text-center">
                    @Model.ErrorMessage
                </div>
            }

            <form method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3 position-relative">
                    <i class="fa fa-user form-icon"></i>
                    <input asp-for="Input.UserName" class="form-control" placeholder="Username" />
                    <span asp-validation-for="Input.UserName" class="text-danger small"></span>
                </div>

                <div class="mb-3 position-relative">
                    <i class="fa fa-phone form-icon"></i>
                    <input asp-for="Input.Phone" class="form-control" placeholder="Phone Number" />
                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-custom">SIGN IN</button>
                    <a href="/Reservation/Signup" class="btn btn-outline-primary btn-custom text-center">SIGN UP</a>
                </div>

            </form>
          
            <div class="text-center mt-4">
                <p class="text-muted">Or login with</p>
                <div class="social-icons">
                    <a href="#"><i class="fab fa-facebook"></i></a>
                    <a href="#"><i class="fab fa-google"></i></a>
                    <a href="#"><i class="fab fa-linkedin"></i></a>
                </div>
                <br />
                <div>
                    <a id="LogoutBtn" class="btn btn-outline-dark home-btn">Back Home Page</a>
                </div>
            </div>
          
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <script>
        $(document).ready(function(){
    $("#LogoutBtn").on("click", function(){
    $.ajax({
    url: "https://localhost:7067/api/Logout",
    type: "POST",
    success: function() {
    window.location = "/";
    }
    });
    });
    });
    </script>
</body>
</html>
